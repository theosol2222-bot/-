# Copiez ce fichier en .env (chmod 600) et remplissez. Ne le commitez jamais.

# Twitch — application gratuite sur https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Claude — analyse du contexte et rédaction (optionnel : sans clé, heuristique)
ANTHROPIC_API_KEY=

# TikTok — Content Posting API, https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/tiktok/callback

# Mot de passe du tableau de bord (HTTP Basic, utilisateur "admin")
DASHBOARD_PASSWORD=
